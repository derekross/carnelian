#!/bin/bash

# Carnelian: publish a markdown file to Nostr as a long-form article (NIP-23).
#
# Usage:
#   carnelian [file.md] [options]     Publish a file, or the file open in Omawrite.
#   carnelian setup [--policy P] [--relay URL]...
#                                   Pair with the Opal signer (NIP-46).
#   carnelian test                  Sign a throwaway note through the signer; send nothing.
#   carnelian status                Show the signer and config in use.
#
# Options:
#   --dry-run          Build and print the event; sign nothing, send nothing.
#   --slug <slug>      Override the article slug (the NIP-33 "d" tag).
#   --relay <url>      Publish to this relay instead of the configured ones. Repeatable.
#   --yes, -y          Skip the confirmation prompt.
#   -h, --help         This text.
#
# Metadata comes from optional YAML front matter:
#
#   ---
#   title: Goodbye Dock
#   summary: One paragraph shown in feeds.
#   image: https://example.com/cover.png
#   tags: [omarchy, linux]
#   slug: omarchy-goodbye-dock
#   date: 2026-09-23
#   ---
#
# Fallbacks when a field is missing:
#   title      the first "# Heading" in the file
#   slug       the filename without a YYYY-MM-DD- prefix and the .md suffix
#   date       the YYYY-MM-DD prefix of the filename, else now
#   summary    the first paragraph after the title, trimmed to 300 characters
#
# The leading H1 is removed from the body because clients render the title
# tag. Publishing the same slug again replaces the earlier version on relays,
# so an edit is just a rerun.
#
# Signing, in order of preference:
#   1. NOSTR_SECRET_KEY in the environment (nsec, hex, ncryptsec or bunker://)
#   2. ~/.config/carnelian/bunker, written by `carnelian setup` (Opal, NIP-46)
#   3. a key prompt from nak

set -euo pipefail

CONFIG_DIR="${CARNELIAN_CONFIG_DIR:-$HOME/.config/carnelian}"
CONFIG_FILE="$CONFIG_DIR/config"
BUNKER_FILE="$CONFIG_DIR/bunker"
CLIENT_KEY_FILE="$CONFIG_DIR/client-key"
OMAWRITE_STATE_DIR="$HOME/.local/share/Omacom/omawrite"
APP_NAME="Carnelian"

DEFAULT_RELAYS=(
    "wss://relay.primal.net"
    "wss://relay.damus.io"
    "wss://relay.ditto.pub"
    "wss://nos.lol"
    "wss://relay.snort.social"
)

# Relays the signer and Carnelian talk over (NIP-46). Small, reliable, and
# known to accept kind 24133. Override with `carnelian setup --relay`.
SIGNER_RELAYS=(
    "wss://relay.ditto.pub"
    "wss://relay.dreamith.to"
    "wss://relay.primal.net"
)

usage() {
    sed -n '3,42p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-1}"
}

die() { echo "carnelian: $*" >&2; exit 1; }

need() {
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || die "'$cmd' is required. $(install_hint "$cmd")"
    done
}

install_hint() {
    case "$1" in
        nak) echo "Install it with: omarchy pkg aur add nak-bin" ;;
        opal) echo "Install Opal from https://github.com/derekross/opal" ;;
        *) echo "" ;;
    esac
}

# --- Config -------------------------------------------------------------------

RELAYS=()
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
    if [ -n "${CARNELIAN_RELAYS:-}" ]; then
        read -r -a RELAYS <<<"$CARNELIAN_RELAYS"
    fi
fi

# --- Signer -------------------------------------------------------------------

# nak's bunker client waits forever if any relay named in the bunker link never
# connects, so drop the ones that do not answer within a few seconds. Prints
# the rewritten link.
prune_bunker_relays() {
    local url="$1" base query out=() keep=() r decoded pids=() i
    base="${url%%\?*}"
    query="${url#*\?}"
    [ "$query" != "$url" ] || { printf '%s\n' "$url"; return 0; }

    local params=() relays=()
    IFS='&' read -r -a params <<<"$query"
    for r in "${params[@]}"; do
        case "$r" in
            relay=*) relays+=("$r") ;;
            *) out+=("$r") ;;
        esac
    done
    [ ${#relays[@]} -gt 1 ] || { printf '%s\n' "$url"; return 0; }

    local tmp
    tmp=$(mktemp -d)
    for i in "${!relays[@]}"; do
        decoded=$(python3 -c 'import sys,urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' "${relays[$i]#relay=}")
        ( timeout "${CARNELIAN_RELAY_PROBE_SECONDS:-15}" nak --connect-timeout "${CARNELIAN_CONNECT_TIMEOUT:-10s}" req -k 24133 --limit 1 "$decoded" >/dev/null 2>&1 \
            && touch "$tmp/$i" ) &
        pids+=($!)
    done
    wait "${pids[@]}" 2>/dev/null || true
    for i in "${!relays[@]}"; do
        if [ -e "$tmp/$i" ]; then
            keep+=("${relays[$i]}")
        else
            echo "Skipping unreachable signer relay: $(python3 -c 'import sys,urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' "${relays[$i]#relay=}")" >&2
        fi
    done
    rm -rf "$tmp"
    [ ${#keep[@]} -gt 0 ] || keep=("${relays[@]}")   # nothing answered; let nak try them all
    local IFS='&'
    printf '%s?%s\n' "$base" "${keep[*]}${out[*]:+&${out[*]}}"
}

# Exports NOSTR_SECRET_KEY (and NOSTR_CLIENT_KEY for bunkers) from the config
# directory unless the environment already provides a key. Prints which one
# is in use. Returns 1 when nothing is configured, in which case nak prompts.
load_signer() {
    if [ -n "${NOSTR_SECRET_KEY:-}" ]; then
        case "$NOSTR_SECRET_KEY" in
            bunker://*)
                NOSTR_SECRET_KEY=$(prune_bunker_relays "$NOSTR_SECRET_KEY")
                export NOSTR_SECRET_KEY
                SIGNER_DESC="bunker from the environment" ;;
            *) SIGNER_DESC="key from the environment" ;;
        esac
        return 0
    fi
    if [ -s "$BUNKER_FILE" ]; then
        NOSTR_SECRET_KEY=$(prune_bunker_relays "$(tr -d '[:space:]' <"$BUNKER_FILE")")
        export NOSTR_SECRET_KEY
        if [ -s "$CLIENT_KEY_FILE" ]; then
            NOSTR_CLIENT_KEY=$(tr -d '[:space:]' <"$CLIENT_KEY_FILE")
            export NOSTR_CLIENT_KEY
        fi
        SIGNER_DESC="Opal (NIP-46) via $BUNKER_FILE"
        return 0
    fi
    SIGNER_DESC="none configured; nak will prompt for a key"
    return 1
}

check_perms() {
    local f="$1" perms
    [ -e "$f" ] || return 0
    perms=$(stat -c %a "$f")
    [ "$perms" = 600 ] || [ "$perms" = 400 ] || die "$f must be mode 600 (is $perms). Fix with: chmod 600 '$f'"
}

# --- setup --------------------------------------------------------------------

cmd_setup() {
    local policy="manual"
    local signer_relays=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --policy) policy="${2:-}"; shift ;;
            --policy=*) policy="${1#--policy=}" ;;
            --relay) signer_relays+=("${2:-}"); shift ;;
            --relay=*) signer_relays+=("${1#--relay=}") ;;
            -h|--help) usage 0 ;;
            *) die "unknown setup option: $1" ;;
        esac
        shift
    done
    need nak opal

    umask 077
    mkdir -p "$CONFIG_DIR"

    if [ -s "$CLIENT_KEY_FILE" ]; then
        echo "Client key:  keeping $CLIENT_KEY_FILE"
    else
        nak key generate | tr -d '[:space:]' >"$CLIENT_KEY_FILE"
        chmod 600 "$CLIENT_KEY_FILE"
        echo "Client key:  generated $CLIENT_KEY_FILE"
    fi

    if [ -s "$BUNKER_FILE" ]; then
        echo "Bunker:      $BUNKER_FILE already exists."
        echo "             Delete it and rerun setup to pair again (then revoke the old '$APP_NAME' in Opal)."
    else
        opal status >/dev/null 2>&1 || die "Opal is not running or not reachable. Start it, then rerun setup."
        local out uri
        [ ${#signer_relays[@]} -gt 0 ] || signer_relays=("${SIGNER_RELAYS[@]}")
        local relay_args=() r
        for r in "${signer_relays[@]}"; do relay_args+=(--relay "$r"); done
        out=$(opal bunker --name "$APP_NAME" --policy "$policy" "${relay_args[@]}" 2>&1) || die "opal bunker failed: $out"
        uri=$(grep -oE 'bunker://[^[:space:]"]+' <<<"$out" | head -1)
        [ -n "$uri" ] || die "could not find a bunker:// link in opal's output: $out"
        echo "Checking the signer relays..."
        uri=$(prune_bunker_relays "$uri")
        printf '%s\n' "$uri" >"$BUNKER_FILE"
        chmod 600 "$BUNKER_FILE"
        echo "Bunker:      wrote $BUNKER_FILE (policy: $policy)"
        echo "Relays:      ${signer_relays[*]}"
    fi

    if [ ! -f "$CONFIG_FILE" ]; then
        cat >"$CONFIG_FILE" <<EOF
# Carnelian configuration. Sourced by bash.
# Relays to publish to, space separated. Leave unset for the defaults.
# CARNELIAN_RELAYS="wss://relay.primal.net wss://relay.damus.io"
EOF
        chmod 600 "$CONFIG_FILE"
        echo "Config:      wrote $CONFIG_FILE"
    fi

    echo ""
    echo "Paired with Opal as '$APP_NAME'. The first publish opens Opal's approval"
    echo "dialog; choose 'remember' there if you do not want to approve every article."
    echo "Try it: carnelian test"
}

# --- test ---------------------------------------------------------------------

cmd_test() {
    need nak
    load_signer || die "no signer configured. Run: carnelian setup"
    check_perms "$BUNKER_FILE"
    check_perms "$CLIENT_KEY_FILE"
    echo "Signer: $SIGNER_DESC"
    echo "Asking the signer for a signature on a throwaway note. Nothing is sent to any relay."
    local out
    if ! out=$(timeout "${CARNELIAN_PUBLISH_TIMEOUT:-120}" \
            nak --connect-timeout "${CARNELIAN_CONNECT_TIMEOUT:-10s}" event -k 1 -c "Carnelian signer test $(date +%s) (never published)" </dev/null); then
        die "the signer did not answer. Is Opal unlocked, and did you approve the request?"
    fi
    local pk
    pk=$(jq -r '.pubkey' <<<"$out")
    echo "Signed by: $(nak encode npub "$pk" 2>/dev/null || echo "$pk")"
    echo "OK: the signer works."
}

# --- status -------------------------------------------------------------------

cmd_status() {
    load_signer || true
    echo "Signer:  $SIGNER_DESC"
    if [ -s "$CLIENT_KEY_FILE" ]; then
        echo "Client:  $(nak key public "$(tr -d '[:space:]' <"$CLIENT_KEY_FILE")" 2>/dev/null || echo "$CLIENT_KEY_FILE")"
    fi
    echo "Relays:  ${RELAYS[*]:-${DEFAULT_RELAYS[*]}}"
    if command -v opal >/dev/null 2>&1; then
        echo "Opal:    $(opal status 2>/dev/null | head -1 | sed 's/^Signer: *//' || echo 'not reachable')"
    fi
    local open
    open=$(omawrite_open_file 2>/dev/null || true)
    echo "Omawrite: ${open:-nothing open}$(omawrite_is_modified && echo ' (unsaved changes)')"
}

# --- Omawrite -----------------------------------------------------------------
#
# Omawrite only writes recovery-N.json while a document has unsaved changes, so
# the open file has to come from the window title ("* name.md - Omawrite" when
# modified) plus Omawrite's last save directory.

OMAWRITE_CONF="$HOME/.config/Omacom/omawrite.conf"

omawrite_title() {
    local active
    active=$(hyprctl activewindow -j 2>/dev/null | jq -r 'select(.class == "omawrite") | .title // empty')
    if [ -z "$active" ]; then
        active=$(hyprctl clients -j 2>/dev/null | jq -r '[.[] | select(.class == "omawrite")] | sort_by(-.focusHistoryID) | last | .title // empty')
    fi
    printf '%s' "$active"
}

omawrite_is_modified() {
    [[ "$(omawrite_title)" == "* "* ]]
}

omawrite_open_file() {
    local title base dir candidate newest
    title=$(omawrite_title)
    [ -n "$title" ] || return 1
    base="${title#\* }"
    base="${base% - Omawrite}"
    [ -n "$base" ] && [ "$base" != "Untitled.md" ] || return 1

    # 1. The directory Omawrite last saved into.
    dir=$(sed -n 's/^lastSaveDirectory=//p' "$OMAWRITE_CONF" 2>/dev/null | head -1)
    if [ -n "$dir" ] && [ -f "$dir/$base" ]; then
        printf '%s\n' "$dir/$base"
        return 0
    fi

    # 2. A recovery file for an unsaved edit of a saved document.
    for candidate in "$OMAWRITE_STATE_DIR"/recovery-*.json; do
        [ -f "$candidate" ] || continue
        candidate=$(jq -r '.fileUrl // empty' "$candidate" | python3 -c '
import sys, urllib.parse
u = sys.stdin.read().strip()
print(urllib.parse.unquote(u[7:]) if u.startswith("file://") else "")')
        if [ -n "$candidate" ] && [ "$(basename "$candidate")" = "$base" ] && [ -f "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    # 3. The newest file of that name under the home directory.
    newest=$(find "$HOME" -maxdepth 6 -type f -name "$base" \
        -not -path '*/node_modules/*' -not -path '*/.git/*' -not -path '*/.cache/*' \
        -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
    if [ -n "$newest" ]; then
        printf '%s\n' "$newest"
        return 0
    fi
    return 1
}

# --- publish ------------------------------------------------------------------

cmd_publish() {
    need nak jq python3

    local file="" dry_run=0 assume_yes=0 slug_override=""
    local cli_relays=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage 0 ;;
            --dry-run) dry_run=1 ;;
            --yes|-y) assume_yes=1 ;;
            --slug) slug_override="${2:-}"; shift ;;
            --slug=*) slug_override="${1#--slug=}" ;;
            --relay) cli_relays+=("${2:-}"); shift ;;
            --relay=*) cli_relays+=("${1#--relay=}") ;;
            -*) die "unknown option: $1 (see --help)" ;;
            *)
                [ -z "$file" ] || die "more than one file given: $file, $1"
                file="$1"
                ;;
        esac
        shift
    done

    [ ${#cli_relays[@]} -gt 0 ] && RELAYS=("${cli_relays[@]}")
    [ ${#RELAYS[@]} -gt 0 ] || RELAYS=("${DEFAULT_RELAYS[@]}")

    if [ -z "$file" ]; then
        file=$(omawrite_open_file || true)
        if [ -z "$file" ]; then
            if [ -n "$(omawrite_title)" ]; then
                die "Omawrite's document has not been saved yet. Save it (Ctrl+S), then publish."
            fi
            die "no file given and no Omawrite window found. Usage: carnelian <file.md>"
        fi
        echo "Using the file open in Omawrite: $file"
        if omawrite_is_modified; then
            echo "Warning: Omawrite has unsaved changes. Save (Ctrl+S) and rerun to publish them." >&2
        fi
    fi
    [ -f "$file" ] || die "file not found: $file"

    local tmp
    tmp=$(mktemp -d)
    # shellcheck disable=SC2064  # expand now: the trap runs after this local is gone
    trap "rm -rf '$tmp'" EXIT
    local meta="$tmp/meta.json" body="$tmp/body.md"

    FILE="$file" META_FILE="$meta" BODY_FILE="$body" SLUG_OVERRIDE="$slug_override" python3 - <<'PYEOF'
import datetime, json, os, re, sys, time
import yaml

path = os.environ["FILE"]
text = open(path, encoding="utf-8").read()

meta, body = {}, text
m = re.match(r"^---[ \t]*\n(.*?)\n---[ \t]*\n?", text, re.DOTALL)
if m:
    try:
        loaded = yaml.safe_load(m.group(1)) or {}
    except yaml.YAMLError as e:
        sys.exit(f"front matter is not valid YAML: {e}")
    if not isinstance(loaded, dict):
        sys.exit("front matter must be a YAML mapping")
    meta = {str(k).lower(): v for k, v in loaded.items()}
    body = text[m.end():]
body = body.lstrip("\n")

base = os.path.splitext(os.path.basename(path))[0]
date_prefix = re.match(r"^(\d{4}-\d{2}-\d{2})-(.+)$", base)

# Title: front matter, else the first H1, which is then removed from the body.
h1 = re.match(r"^#[ \t]+(.+?)[ \t]*#*[ \t]*\n", body)
title = str(meta.get("title") or "").strip()
if h1:
    if not title:
        title = h1.group(1).strip()
    if h1.group(1).strip() == title:
        body = body[h1.end():].lstrip("\n")
if not title:
    # No front matter title and no H1: fall back to the filename, prettified.
    stem = date_prefix.group(2) if date_prefix else base
    title = re.sub(r"[-_]+", " ", stem).strip().title()
    print(f"Note: no '# Heading' or front matter title found; using \"{title}\" from the filename.", file=sys.stderr)

# Slug: --slug, front matter, else the filename minus a date prefix.
slug = os.environ.get("SLUG_OVERRIDE") or str(meta.get("slug") or "").strip()
if not slug:
    slug = date_prefix.group(2) if date_prefix else base
slug = re.sub(r"[^a-z0-9]+", "-", slug.lower()).strip("-")
if not slug:
    sys.exit("could not derive a slug; pass --slug")

# Published date: front matter, else the filename prefix, else now.
raw = meta.get("published_at") or meta.get("date")
if raw is None and date_prefix:
    raw = date_prefix.group(1)
if raw is None:
    published_at = int(time.time())
elif isinstance(raw, int):
    published_at = raw
else:
    if isinstance(raw, datetime.datetime):
        dt = raw
    elif isinstance(raw, datetime.date):
        dt = datetime.datetime(raw.year, raw.month, raw.day, 12, 0)
    else:
        s = str(raw).strip()
        try:
            dt = datetime.datetime.fromisoformat(s)
        except ValueError:
            sys.exit(f"could not parse date {s!r}; use YYYY-MM-DD")
        if len(s) == 10:
            dt = dt.replace(hour=12)
    if dt.tzinfo is None:
        dt = dt.astimezone()
    published_at = int(dt.timestamp())

# Summary: front matter, else the first plain paragraph.
summary = str(meta.get("summary") or meta.get("description") or meta.get("excerpt") or "").strip()
if not summary:
    for para in re.split(r"\n\s*\n", body):
        p = para.strip()
        if p and not p.startswith(("#", "!", "```", "<", "-", "*", ">")):
            p = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", p)
            p = re.sub(r"[*_`]", "", p)
            summary = re.sub(r"\s+", " ", p)
            if len(summary) > 300:
                summary = summary[:297].rsplit(" ", 1)[0] + "..."
            break

image = str(meta.get("image") or meta.get("cover") or "").strip()

tags = meta.get("tags") or []
if isinstance(tags, str):
    tags = [t for t in re.split(r"[,\s]+", tags) if t]
tags = [re.sub(r"^#", "", str(t)).strip().lower() for t in tags]
tags = [t for t in dict.fromkeys(tags) if t]

open(os.environ["BODY_FILE"], "w", encoding="utf-8").write(body.rstrip() + "\n")
json.dump({"title": title, "slug": slug, "summary": summary, "image": image,
           "published_at": published_at, "tags": tags}, open(os.environ["META_FILE"], "w"))
PYEOF

    local title slug summary image published_at
    title=$(jq -r '.title' "$meta")
    slug=$(jq -r '.slug' "$meta")
    summary=$(jq -r '.summary' "$meta")
    image=$(jq -r '.image' "$meta")
    published_at=$(jq -r '.published_at' "$meta")
    local hashtags=()
    mapfile -t hashtags < <(jq -r '.tags[]' "$meta")

    local tag_args=(-t "title=$title" -t "published_at=$published_at")
    [ -n "$summary" ] && tag_args+=(-t "summary=$summary")
    [ -n "$image" ] && tag_args+=(-t "image=$image")
    local t
    for t in "${hashtags[@]}"; do tag_args+=(-t "t=$t"); done

    echo ""
    echo "=== Article ==="
    echo "File:      $file"
    echo "Title:     $title"
    echo "Slug (d):  $slug"
    echo "Date:      $(date -d "@$published_at" '+%Y-%m-%d %H:%M %Z') ($published_at)"
    echo "Summary:   ${summary:-<none>}"
    echo "Image:     ${image:-<none>}"
    echo "Hashtags:  ${hashtags[*]:-<none>}"
    echo "Body:      $(wc -w <"$body") words, $(wc -l <"$body") lines"
    echo ""
    echo "=== Body preview (first 20 lines) ==="
    head -20 "$body"
    echo "..."
    echo ""

    if [ "$dry_run" -eq 1 ]; then
        echo "=== Dry run: the event as it would be published (signed with a throwaway key) ==="
        env -u NOSTR_SECRET_KEY -u NOSTR_CLIENT_KEY \
            nak --connect-timeout "${CARNELIAN_CONNECT_TIMEOUT:-10s}" event -k 30023 -d "$slug" "${tag_args[@]}" -c "@$body" </dev/null | jq .
        echo ""
        echo "Relays that would receive it: ${RELAYS[*]}"
        return 0
    fi

    local have_signer=1
    load_signer || have_signer=0
    check_perms "$BUNKER_FILE"
    check_perms "$CLIENT_KEY_FILE"

    echo "Signer: $SIGNER_DESC"
    echo "Relays: ${RELAYS[*]}"
    if [ "$assume_yes" -ne 1 ]; then
        local reply
        read -r -p "Publish \"$title\" to Nostr? [y/N] " reply </dev/tty
        [[ "$reply" =~ ^[Yy]$ ]] || { echo "Aborted."; return 0; }
    fi

    echo "Publishing..."
    # nak treats a piped stdin as event input, so keep stdin off a pipe. The key
    # prompt reads the terminal directly.
    if [ "$have_signer" -eq 1 ]; then
        if ! timeout "${CARNELIAN_PUBLISH_TIMEOUT:-120}" \
            nak --connect-timeout "${CARNELIAN_CONNECT_TIMEOUT:-10s}" event -k 30023 -d "$slug" "${tag_args[@]}" -c "@$body" "${RELAYS[@]}" </dev/null; then
            die "publishing failed or timed out. Is Opal unlocked, and did you answer its approval dialog?"
        fi
    else
        nak event --prompt-sec -k 30023 -d "$slug" "${tag_args[@]}" -c "@$body" "${RELAYS[@]}" </dev/tty
    fi

    echo ""
    echo "Done. Published \"$title\" as kind 30023 with d=$slug."
    echo "Rerun after edits to replace it."
}

# --- main ---------------------------------------------------------------------

case "${1:-}" in
    setup) shift; cmd_setup "$@" ;;
    test) shift; cmd_test "$@" ;;
    status) shift; cmd_status "$@" ;;
    -h|--help) usage 0 ;;
    *) cmd_publish "$@" ;;
esac
